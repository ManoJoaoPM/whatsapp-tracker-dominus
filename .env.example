# --- Core ---
PORT=3001
# Behind a reverse proxy (nginx, Traefik, Caddy...) set the number of proxies so rate limits see the real client IP
TRUST_PROXY=
APP_URL=https://your-public-domain.example
MONGODB_URI=mongodb://localhost:27017/leadtrack-wa
# Optional second MongoDB used to store image/audio payloads
MEDIA_MONGODB_URI=

# --- Auth (required: the server refuses to start without JWT_SECRET) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Encryption of per-client secrets (Meta CAPI token) ---
SECRETS_MASTER_KEY=

# --- Evolution API (unofficial WhatsApp gateway) ---
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_GLOBAL_API_KEY=
# Shared secret appended to the webhook URL. When set, the webhook rejects requests without it.
# After setting it, run: npx tsx api/scripts/reregister-evolution-webhooks.ts
EVOLUTION_WEBHOOK_TOKEN=

# --- WhatsApp Cloud API (official) ---
# Token used by Meta to verify the webhook subscription (GET)
WHATSAPP_CLOUD_VERIFY_TOKEN=
# Required: the Cloud webhook rejects every request while this is empty
WHATSAPP_CLOUD_APP_SECRET=

# --- AI qualification (MQL) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# Seconds of silence after the last message before a conversation is scored
MQL_DEBOUNCE_SECONDS=120
# Never score the same conversation more often than this (seconds)
MQL_MIN_INTERVAL_SECONDS=300
# Lead messages needed before the first score
MQL_MIN_INBOUND=2
# Lead messages needed before an event can be sent to Meta
MQL_CONFIRM_MIN_INBOUND=2
# Hours without an answer from the lead before the silence re-evaluation (-20 points)
MQL_SILENCE_HOURS=48
